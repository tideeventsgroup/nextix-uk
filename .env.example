# Supabase Postgres connection (Project Settings -> Database -> Connection string,
# use the "Transaction" pooler on port 6543 for serverless/Vercel deployments)
DATABASE_URL=postgresql://user:password@host:6543/postgres

# Better Auth
BETTER_AUTH_SECRET=generate-with-openssl-rand-base64-32
BETTER_AUTH_URL=https://your-deployment-url

# Better Auth Dash (dashboard/analytics plugin, @better-auth/infra)
BETTER_AUTH_API_KEY=your-better-auth-dash-api-key
